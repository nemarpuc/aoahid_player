# udev rules for aoahid-player, the same as libaoahid's.
#
# The programs open the phone in its current USB mode, where it keeps its own
# manufacturer vendor and product IDs (a Samsung phone is 04e8:xxxx, for
# example), so there is no fixed ID to match. Phones are often already
# accessible to the logged-in user (libmtp's and systemd's uaccess rules), so
# try without this file first. If opening the phone fails with an access
# error, install it:
#   sudo cp udev/51-aoahid.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
# and replug the phone.
#
# This gives the user at the local seat access to USB devices through
# systemd-logind's uaccess tag.
SUBSYSTEM=="usb", TAG+="uaccess"

# Without logind, grant a group access to your own phone instead. Find its
# vendor ID with `lsusb`, and avoid MODE="0666" or matching every device.
# For example:
#   SUBSYSTEM=="usb", ATTR{idVendor}=="04e8", MODE="0660", GROUP="plugdev"

# After Accessory Mode the phone re-enumerates as Google's 18d1:2d00-2d05
# (2d01 adds adb). The uaccess rule above covers it; this is the group-based
# alternative.
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", ATTR{idProduct}=="2d0[0-5]", MODE="0660", GROUP="plugdev"
